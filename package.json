{
  "name": "guidebook_server",
  "version": "1.0.0",
  "description": "ILCA official guidebook server",
  "author": "Nitzan Ben Ner <nitzanbenner@gmail.com>",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --enable-source-maps -r dotenv/config dist/server.js",
    "dev": "nodemon --exec \"tsx -r dotenv/config\" server.js",
    "build": "tsup",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts}\"",
    "format": "eslint \"**/*.{js,ts}\" --fix",
    "prettier": "prettier --write \"{,!(node_modules)/**/}*.{js,jsx,ts,tsx}\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "contentful": "^10.12.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.10.0",
    "express": "^4.19.2",
    "express-jwt": "^8.4.1",
    "image-to-base64": "^2.2.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongoose": "^8.4.3",
    "nodemon": "^3.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.2",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
